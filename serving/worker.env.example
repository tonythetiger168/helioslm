# Container env for the serverless vLLM worker. Paste values as-is.
# Build the image with VLLM_VERSION=v0.33.0 (build arg; the image default
# v0.23.0 is too old). Endpoint settings, not env vars: one 80 GB GPU,
# scale to zero when idle. HF_TOKEN is a platform secret-store name only;
# do not assign it in this file.

# Private BF16 safetensors repo. Alias of --model.
MODEL_NAME=chienhsinlin/helioslm-chat-g26b

# API model id. Alias of --served-model-name.
OPENAI_SERVED_MODEL_NAME_OVERRIDE=helioslm

# Checkpoint dtype. Quantization stays unset.
DTYPE=bfloat16

# Weight files are safetensors. Maps to --load-format.
LOAD_FORMAT=safetensors

# One GPU. Maps to --tensor-parallel-size.
TENSOR_PARALLEL_SIZE=1

# Context length. Maps to --max-model-len.
MAX_MODEL_LEN=16384

# In-flight sequences. Allowlisted as --max-num-seqs.
MAX_NUM_SEQS=16

# Native MTP head, four speculative tokens. Method stays mtp.
SPECULATIVE_CONFIG={"method":"mtp","model":"google/gemma-4-26B-A4B-it-assistant","num_speculative_tokens":4}
