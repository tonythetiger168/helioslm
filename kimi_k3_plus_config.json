{
  "model_name": "Kimi-K3-Plus",
  "version": "1.0.0",
  "architecture": {
    "type": "MixtureOfExperts",
    "total_params": "2.8T",
    "active_params_per_token": "104B",
    "vocab_size": 160000,
    "max_position_embeddings": 1048576,
    "hidden_size": 7168,
    "num_attention_heads": 96,
    "num_key_value_heads": 8,
    "num_hidden_layers": 93,
    "intermediate_size": 28672,
    "rms_norm_eps": 1e-06,
    "rope_theta": 1000000.0,
    "use_cache": true,
    "tie_word_embeddings": false,
    "torch_dtype": "bfloat16",
    "transformers_version": "4.50.0"
  },
  "attention": {
    "type": "KimiDeltaAttention",
    "kda_ratio": "3:1",
    "linear_attention_variant": "GatedMLA",
    "use_nope": true,
    "attention_residuals": {
      "enabled": true,
      "skip_connections": "adaptive",
      "residual_depth": 4
    },
    "sliding_window": null,
    "attention_dropout": 0.0
  },
  "moe": {
    "type": "StableLatentMoE",
    "num_experts": 896,
    "num_shared_experts": 4,
    "num_activated_experts": 16,
    "expert_grouping": {
      "enabled": true,
      "groups": [
        {
          "name": "programming",
          "expert_indices": "0-223",
          "specialty": "code_generation_debugging"
        },
        {
          "name": "mathematics",
          "expert_indices": "224-447",
          "specialty": "math_reasoning_symbolic"
        },
        {
          "name": "science",
          "expert_indices": "448-671",
          "specialty": "scientific_literature_analysis"
        },
        {
          "name": "creative",
          "expert_indices": "672-895",
          "specialty": "writing_brainstorming_design"
        }
      ]
    },
    "dynamic_sparsity": {
      "enabled": true,
      "min_experts": 8,
      "max_experts": 16,
      "adjustment_strategy": "task_difficulty_estimation"
    },
    "load_balancing": {
      "loss_coef": 0.01,
      "top_k": 2,
      "capacity_factor": 1.25
    },
    "activation": "SiTU_GLU",
    "expert_hidden_size": 3584
  },
  "multimodal": {
    "enabled": true,
    "modalities": [
      "text",
      "image",
      "video",
      "audio"
    ],
    "vision_encoder": {
      "type": "ViT-Large",
      "image_size": 448,
      "patch_size": 14,
      "num_channels": 3,
      "hidden_size": 1024,
      "num_attention_heads": 16,
      "num_hidden_layers": 24
    },
    "video_encoder": {
      "type": "TimeSformer",
      "temporal_resolution": 16,
      "frame_sample_rate": 4,
      "temporal_encoding": "sinusoidal_position"
    },
    "audio_encoder": {
      "type": "Whisper-Large",
      "sampling_rate": 16000,
      "n_mels": 128
    },
    "cross_modal_alignment": {
      "enabled": true,
      "alignment_loss": "contrastive",
      "projection_dim": 7168
    }
  },
  "reasoning": {
    "always_on_thinking": true,
    "reasoning_effort": "adaptive",
    "effort_levels": {
      "low": {
        "max_tokens": 1024,
        "temperature": 0.3
      },
      "high": {
        "max_tokens": 8192,
        "temperature": 0.7
      },
      "max": {
        "max_tokens": 32768,
        "temperature": 0.9
      }
    },
    "chain_of_thought": {
      "enabled": true,
      "compilation": true,
      "format": "structured_xml"
    }
  },
  "agent": {
    "tool_calling": {
      "enabled": true,
      "protocol": "MCP",
      "max_tools_per_turn": 8,
      "tool_timeout_seconds": 30
    },
    "long_term_memory": {
      "enabled": true,
      "type": "external_kv_cache",
      "memory_bank": {
        "vector_store": "faiss",
        "embedding_dim": 7168,
        "max_memories": 100000,
        "compression_ratio": 0.1
      },
      "session_summary": {
        "enabled": true,
        "summarization_model": "internal",
        "trigger_threshold": 16384
      }
    }
  },
  "quantization": {
    "training": {
      "weight_format": "MXFP4",
      "activation_format": "MXFP8",
      "quantization_aware_training": true
    },
    "inference": {
      "cloud": {
        "weight_bits": 4,
        "activation_bits": 8,
        "format": "MXFP"
      },
      "edge": {
        "weight_bits": 4,
        "activation_bits": 4,
        "format": "AWQ"
      },
      "mobile": {
        "weight_bits": 3,
        "activation_bits": 4,
        "format": "GPTQ"
      }
    }
  },
  "speculative_decoding": {
    "enabled": true,
    "draft_model": {
      "name": "Kimi-K3-Plus-Draft-30B",
      "params": "30B",
      "layers": 32,
      "hidden_size": 4096,
      "num_experts": 64,
      "num_activated_experts": 4
    },
    "verification_strategy": "tree_attention",
    "max_draft_tokens": 5,
    "acceptance_threshold": 0.8
  },
  "training": {
    "phases": [
      {
        "name": "pretraining",
        "data_tokens": "15T",
        "context_length_progression": [
          32768,
          131072,
          1048576
        ],
        "batch_size": 4096,
        "learning_rate": 0.00015,
        "warmup_steps": 2000,
        "lr_scheduler": "cosine_with_restarts",
        "optimizer": "AdamW",
        "weight_decay": 0.1,
        "gradient_clipping": 1.0,
        "mixed_precision": "bf16"
      },
      {
        "name": "continual_pretraining",
        "data_tokens": "3T",
        "focus": "reasoning_and_code",
        "learning_rate": 5e-05,
        "batch_size": 2048,
        "expert_load_balancing": true,
        "quantization_aware": true
      },
      {
        "name": "sft",
        "data_samples": 500000,
        "learning_rate": 2e-05,
        "batch_size": 256,
        "epochs": 3,
        "lora": {
          "enabled": true,
          "r": 256,
          "alpha": 512,
          "dropout": 0.05,
          "target_modules": [
            "q_proj",
            "v_proj",
            "o_proj",
            "gate_proj"
          ]
        },
        "freeze_attnres": true
      },
      {
        "name": "rlhf",
        "algorithm": "PPO+DPO_hybrid",
        "reward_model": "Kimi-K3-Plus-Reward",
        "kl_penalty": 0.02,
        "ppo_epochs": 4,
        "dpo_beta": 0.1,
        "constitutional_ai": {
          "enabled": true,
          "principles": [
            "helpful",
            "harmless",
            "honest",
            "creative"
          ]
        }
      }
    ]
  }
}